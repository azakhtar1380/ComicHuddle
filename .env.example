# ComicHuddle settings. Names only: put real values in Vercel (and .env.local for local work). Never commit secrets.
# See docs/COMMERCE-ROUND5-SETTINGS.md, docs/PROFILE-ROUND6.md and docs/CLEANUP-ROUND7.md for what each one does.

# Accounts and staff
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
COMICHUDDLE_OWNER_USER_ID=
# Admins: comma-separated account emails (case-insensitive). COMICHUDDLE_ADMIN_LIMIT caps how many count (default 3).
COMICHUDDLE_ADMIN_EMAILS=
COMICHUDDLE_ADMIN_LIMIT=
# The Founder: one account email (case-insensitive). Shows the Founder badge; the founder is always an admin.
# Server-only: the email never reaches the browser, only a founder:true flag.
COMICHUDDLE_FOUNDER_EMAIL=

# Database (Postgres)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=

# Payments (Stripe test mode on preview) and shipping
COMMERCE_PUBLIC_ORIGIN=
COMMERCE_STRIPE_TEST_SECRET_KEY=
COMMERCE_LISTING_REQUIRES_PAYOUTS=
COMMERCE_PAYOUTS_ENABLED=
EASYPOST_API_KEY=
CRON_SECRET=
# Collector verification fee in cents (default 1000 = $10; 0 turns it off). Refunded in full if declined.
VERIFICATION_FEE_CENTS=

# Trophies: accounts created before this ISO date earn Founding Huddler (unset = nobody earns it).
FOUNDING_HUDDLER_UNTIL=

# Email
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Catalog data
METRON_API_TOKEN=
GCD_USERNAME=
GCD_PASSWORD=

# Photo storage (AWS)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
COVER_STORAGE_BUCKET=
